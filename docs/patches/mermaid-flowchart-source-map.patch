 // We are using arrow functions assigned to class instance fields instead of methods as they are required by flow JISON
 export class FlowDB implements DiagramDB {
+  private sourceMapContext?: ReturnType<typeof prepareFlowSourceMap>;
+  private sourceMapSource = '';
+  private sourcePieces: Omit<DiagramSourcePiece, 'domId'>[] = [];
+  private labelLocations = new WeakMap<object, SourceSpan>();
+  private linkLocations = new WeakMap<object, { span: SourceSpan; labelSpan?: SourceSpan }>();
+
+  public enableSourceMap(source: string) {
+    this.sourceMapContext = prepareFlowSourceMap(source);
+    this.sourceMapSource = source;
+  }
+
+  public verifySourceMapInput(input: string) {
+    if (this.sourceMapContext && this.sourceMapContext.input !== input) {
+      throw new Error('Source map preprocessing does not match parser input');
+    }
+  }
+
+  public recordLabel(value: object, loc: FlowLocation) {
+    if (this.sourceMapContext) {
+      this.labelLocations.set(value, this.sourceMapContext.span(loc));
+    }
+  }
+
+  public recordVertex(id: string, loc: FlowLocation, label?: object) {
+    if (this.sourceMapContext) {
+      const labelSpan = label && this.labelLocations.get(label);
+      this.sourcePieces.push({
+        kind: 'node',
+        semanticId: id,
+        span: this.sourceMapContext.span(loc),
+        ...(labelSpan ? { labelSpan } : {}),
+      });
+    }
+  }
+
+  public recordLink(link: { text?: object }, loc: FlowLocation) {
+    if (this.sourceMapContext) {
+      const labelSpan = link.text && this.labelLocations.get(link.text);
+      this.linkLocations.set(link, {
+        span: this.sourceMapContext.span(loc, true),
+        ...(labelSpan ? { labelSpan } : {}),
+      });
+    }
+  }
+
+  public getSourceMap(): DiagramSourceMap | undefined {
+    if (!this.sourceMapContext) {
+      return undefined;
+    }
+    return {
+      source: this.sourceMapSource,
+      pieces: this.sourcePieces.map((piece) => ({
+        ...piece,
+        domId:
+          piece.kind === 'node' ? this.vertices.get(piece.semanticId)!.domId : piece.semanticId,
+      })),
+    };
+  }
