@@ -0,0 +1,28 @@
+import mermaid from '../../mermaid.js';
+import { Diagram } from '../../Diagram.js';
+import { preprocessDiagram } from '../../preprocess.js';
+
+describe('flowchart source map API', () => {
+  beforeEach(() => mermaid.initialize({ startOnLoad: false }));
+
+  it('opts in through Diagram and leaves normal parses unchanged', async () => {
+    const source = 'flowchart LR\r\n%% comment\r\nA[x] --> B';
+    const { code } = preprocessDiagram(source);
+    const mapped = await Diagram.fromText(code, {}, { sourceMap: true });
+    const saved = mapped.db.getSourceMap!()!;
+    expect(saved.source).toBe(source);
+    expect(saved.pieces[0].span).toEqual({ start: 26, end: 30 });
+    const plain = await Diagram.fromText(code);
+    expect(plain.db.getSourceMap!()).toBeUndefined();
+    expect(saved.pieces[0].semanticId).toBe('A');
+  });
+
+  it('rejects unsupported diagram types and oversized original source', async () => {
+    await expect(
+      Diagram.fromText('sequenceDiagram\nA->>B: Hi', {}, { sourceMap: true })
+    ).rejects.toThrow(/source map/i);
+    mermaid.initialize({ maxTextSize: 30 });
+    const { code } = preprocessDiagram('%% ' + 'x'.repeat(40) + '\nflowchart LR\nA --> B');
+    await expect(Diagram.fromText(code, {}, { sourceMap: true })).rejects.toThrow(/source map/i);
+  });
+});
