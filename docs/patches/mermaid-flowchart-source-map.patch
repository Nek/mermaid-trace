+import { lineCommentPattern } from '../../diagram-api/comments.js';
+import type { SourceSpan } from '../../types.js';
+
+export interface FlowLocation {
+  range?: [number, number];
+}
+
+export const closingBraceWhitespace = /}\s*\n/g;
+
+/** Track only transformations whose original offsets are known exactly. */
+export function prepareFlowSourceMap(source: string) {
+  let chars: { text: string; start: number; end: number }[] = [];
+  for (let i = 0; i < source.length; i++) {
+    const start = i;
+    const text = source[i] === '\r' ? '\n' : source[i];
+    if (source[i] === '\r' && source[i + 1] === '\n') {
+      i++;
+    }
+    chars.push({ text, start, end: i + 1 });
+  }
+  const text = () => chars.map((c) => c.text).join('');
+  const remove = (pattern: RegExp, retainBraces = false) => {
+    const kept: typeof chars = [];
+    let cursor = 0;
+    for (const match of text().matchAll(pattern)) {
+      kept.push(...chars.slice(cursor, match.index));
+      if (retainBraces) {
+        kept.push(chars[match.index], chars[match.index + match[0].length - 1]);
+      }
+      cursor = match.index + match[0].length;
+    }
+    kept.push(...chars.slice(cursor));
+    chars = kept;
+  };
+  remove(lineCommentPattern);
+  chars = chars.slice(text().length - text().trimStart().length);
+  if (
+    !/^(?:flowchart|graph)\s+(?:LR|RL|TB|BT|TD)\b/.test(text()) ||
+    /[&<`]|%%{|@{|#\w+;/.test(text())
+  ) {
+    throw new Error(
+      'Unsupported source map input: plain flowcharts without frontmatter, directives, entities, HTML, Markdown labels or shape metadata are required'
+    );
+  }
+  chars.push({ text: '\n', start: source.length, end: source.length });
+  remove(closingBraceWhitespace, true);
+  const input = text();
+  return {
+    input,
+    span(loc: FlowLocation, trim = false): SourceSpan {
+      let [start, end] = loc.range ?? [-1, -1];
+      if (trim) {
+        const value = input.slice(start, end);
+        start += value.length - value.trimStart().length;
+        end -= value.length - value.trimEnd().length;
+      }
+      if (!chars[start] || !chars[end - 1] || end <= start) {
+        throw new Error('Invalid source map parser range');
+      }
+      return { start: chars[start].start, end: chars[end - 1].end };
+    },
+  };
+}
