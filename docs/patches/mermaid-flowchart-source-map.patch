@@ -0,0 +1,87 @@
+import { FlowDB } from '../flowDb.js';
+import flow from './flowParser.js';
+import { preprocessDiagram } from '../../../preprocess.js';
+import { setConfig } from '../../../config.js';
+
+describe('flowchart source maps', () => {
+  beforeEach(() => {
+    setConfig({ securityLevel: 'strict' });
+    flow.parser.yy = new FlowDB();
+  });
+
+  function parse(source: string) {
+    const db = flow.parser.yy as FlowDB;
+    db.clear();
+    db.enableSourceMap(source);
+    flow.parse(preprocessDiagram(source).code.cleaned + '\n');
+    return db.getSourceMap()!;
+  }
+
+  it('preserves original UTF-16 spans and repeated occurrences', () => {
+    const source =
+      'flowchart LR\r\n%% 😀 comment\r\nA["same"] -->|same| B["same"]\r\nA -->|same| B';
+    const map = parse(source);
+    expect(map.source).toBe(source);
+    const nodes = map.pieces.filter((p) => p.kind === 'node');
+    const edges = map.pieces.filter((p) => p.kind === 'edge');
+    expect(nodes.map((p) => source.slice(p.span.start, p.span.end))).toEqual([
+      'A["same"]',
+      'B["same"]',
+      'A',
+      'B',
+    ]);
+    expect(nodes.slice(0, 2).map((p) => p.labelSpan)).toEqual([
+      { start: 32, end: 36 },
+      { start: 52, end: 56 },
+    ]);
+    expect(edges.map((p) => p.labelSpan)).toEqual([
+      { start: 43, end: 47 },
+      { start: 66, end: 70 },
+    ]);
+    expect(edges.map((p) => source.slice(p.span.start, p.span.end))).toEqual([
+      '-->|same|',
+      '-->|same|',
+    ]);
+    expect(edges.map((p) => [p.from, p.to])).toEqual([
+      ['A', 'B'],
+      ['A', 'B'],
+    ]);
+    expect(edges[0].domId).not.toBe(edges[1].domId);
+    expect(nodes[0].domId).toBe(nodes[2].domId);
+  });
+
+  it('accounts for closing-brace whitespace normalization', () => {
+    const source = 'flowchart LR\nA{Yes}  \n\nB[No]';
+    const map = parse(source);
+    expect(map.pieces.map((p) => p.span)).toEqual([
+      { start: 13, end: 19 },
+      { start: 23, end: 28 },
+    ]);
+  });
+
+  it('does not collect mappings by default or leak them after clear', () => {
+    const db = flow.parser.yy as FlowDB;
+    flow.parse('flowchart LR\nA --> B');
+    expect(db.getSourceMap()).toBeUndefined();
+    const saved = parse('flowchart LR\nA --> B');
+    db.clear();
+    flow.parse('flowchart LR\nC --> D');
+    expect(db.getSourceMap()).toBeUndefined();
+    expect(saved.pieces.map((p) => p.semanticId)).toContain('A');
+  });
+
+  it('rejects unsupported transformations and mismatched parser input', () => {
+    for (const source of [
+      '---\ntitle: Test\n---\nflowchart LR\nA --> B',
+      'flowchart LR\nA["<b>HTML</b>"] --> B',
+      'flowchart LR\nA["`Markdown`"] --> B',
+      '%%{init: {}}%%\nflowchart LR\nA --> B',
+      'flowchart LR\nA@{label: Changed}',
+    ]) {
+      expect(() => parse(source)).toThrow(/source map/i);
+    }
+    const db = flow.parser.yy as FlowDB;
+    db.enableSourceMap('flowchart LR\nA --> B');
+    expect(() => flow.parse('flowchart LR\nC --> D')).toThrow(/source map/i);
+  });
+});
