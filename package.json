{
  "name": "mermaid-trace-workspace",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.28.0",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "typecheck": "corepack pnpm --dir mermaid-trace-ts run typecheck",
    "build": "corepack pnpm --dir mermaid-trace-ts run build",
    "test": "corepack pnpm --dir mermaid-trace-ts run test",
    "snapshots:update": "corepack pnpm --dir mermaid-trace-ts run snapshots:update",
    "demo": "corepack pnpm --dir mermaid-trace-ts run demo",
    "preview": "corepack pnpm --dir mermaid-trace-ts run build && node mermaid-trace-ts/dist/src/cli.js"
  }
}
