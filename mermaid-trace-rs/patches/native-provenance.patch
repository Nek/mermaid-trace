+    // https://serde.rs/enum-representations.html#externally-tagged
+    {
+        #[derive(PartialEq, Debug, Deserialize)]
+        enum Message {
+            #[serde(rename = "req")]
+            Request { id: String, method: String },
+            #[serde(rename = "res")]
+            Response { id: String, result: () },
