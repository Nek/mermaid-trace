+            );
+        } else {
+            assert_eq!(piece["kind"], "nonvisual");
+            assert_eq!(piece["classification"], "unused-section");
+        }
+    }
+    assert!(
+        sections[5].get("labelSpan").is_none(),
+        "a real empty section frame has no invented label"
+    );
