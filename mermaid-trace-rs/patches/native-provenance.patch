+        B,
+        C(()),
+    }
+
+    #[derive(Serialize)]
+    #[serde(rename_all = "kebab-case")]
+    struct Image<'a> {
+        width: usize,
+        height: usize,
+        aspect_ratio: &'a str,
+    }
