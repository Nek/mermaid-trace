+            assert!(((hit.x - node.x) * dy - (hit.y - node.y) * dx).abs() < 1e-9);
+        }
+        let center = intersect_ellipse(
+            &node,
+            &crate::model::LayoutPoint {
+                x: node.x,
+                y: node.y,
+            },
+        );
+        assert_eq!((center.x, center.y), (node.x, node.y));
+    }
+}
