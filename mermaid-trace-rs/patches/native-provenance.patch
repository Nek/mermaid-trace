+            ('∞', f64::INFINITY),
+        ])),
+        Ok("{\n  τ: 6.283185307179586,\n  \"∞\": Infinity,\n}".to_owned())
+    );
+    assert_eq!(
+        to_string(&IndexMap::from([(E::A, 'a'), (E::B, 'b'),])),
+        Ok("{\n  A: \"a\",\n  B: \"b\",\n}".to_owned())
+    );
+    assert_eq!(
